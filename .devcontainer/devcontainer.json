import pandas as pd

def evaluate_student_submission(student_answer: str, question_type: str, max_marks: float) -> dict:
    """
    تقييم إجابة الطالب أو الواجب بناءً على مخرجات التعلم ومعايير السلم (Rubrics)
    """
    score = 0.0
    feedback = ""
    evidence_found = False

    if question_type == "CLO1_Evaluation":
        # معايير تقييم السؤال الأول (Visual Appeal, Functionality, Usability, Accessibility, Performance, Standards)
        keywords = ["visual", "function", "usability", "access", "performance", "standard", "button", "screen reader"]
        matches = sum(1 for kw in keywords if kw in student_answer.lower())
        
        if matches >= 5:
            score = max_marks * 1.0  # ممتاز (Excellent)
            feedback = "تقييم ممتاز: تم تغطية كافة معايير التقييم المطلوبة مع أدلة واضحة من الحالة."
        elif matches >= 3:
            score = max_marks * 0.75 # جيد جداً / جيد
            feedback = "تقييم جيد: تم رصد معظم المعايير، ولكن ينقص بعض الأدلة الداعمة."
        elif matches >= 1:
            score = max_marks * 0.4  # مقبول
            feedback = "تقييم ضعيف/مقبول: تم التطرق لمعيار أو معيارين بحد أدنى."
        else:
            score = 0.0
            feedback = "ضعيف جداً: لم يتم ربط الإجابة بمعايير التقييم المطلوبة."

    elif question_type == "CLO2_Motion_Design":
        # معايير تقييم مبادئ التصميم الحركي (Timing, Easing, Transitions, Visual Rhythm)
        principles = ["timing", "easing", "transition", "rhythm", "speed", "attention", "emotion"]
        matches = sum(1 for p in principles if p in student_answer.lower())
        
        if matches >= 4:
            score = max_marks * 1.0
            feedback = "تطبيق ممتاز لمبادئ الحركة وتأثيرها على انتباه وفهم المشاهد."
        elif matches >= 2:
            score = max_marks * 0.6
            feedback = "تطبيق مقبول لمبادئ الحركة مع قصور في ربطها بتأثيرها العاطفي أو البصري."
        else:
            score = max_marks * 0.2
            feedback = "ضعف في توظيف مبادئ التصميم الحركي."

    return {
        "Earned_Marks": round(score, 2),
        "Max_Marks": max_marks,
        "Feedback": feedback
    }

# مثال عملي لتجربة تقييم إجابة طالب:
sample_answer = "The app has good visual appeal and colors, but functionality fails because booking buttons do not work. Usability is poor due to broken navigation symbols, and accessibility fails screen readers. Performance is slow."
result = evaluate_student_submission(sample_answer, "CLO1_Evaluation", 10)

print("--- نتيجة التقييم الذكي بناءً على المخرجات والمعايير ---")
print(f"الدرجة المستحقة: {result['Earned_Marks']} / {result['Max_Marks']}")
print(f"ملاحظات التقييم والتحليل: {result['Feedback']}")ر
